SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=3DNow <support@example.com>
NOTIFY_TO=freddarlington98@gmail.com
EMAIL_ATTACHMENT_LIMIT_BYTES=20971520
PUBLIC_URL=http://localhost:3000
# Optional: put all local files under one folder (default: ./server)
# STORAGE_ROOT=C:\3dnow-data
# STORAGE_ROOT=/var/lib/3dnow
STRIPE_SECRET_KEY=sk_test_replace_with_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
SHOPIFY_SHOP=your-store.myshopify.com
# Preferred (Dev Dashboard apps): client credentials, auto-refreshed every 24h
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=shpss_replace_with_your_client_secret
# Optional legacy static Admin API token (shpat_...). Prefer CLIENT_ID/SECRET above.
# SHOPIFY_ACCESS_TOKEN=shpat_replace_with_your_access_token
# Optional override; defaults to SHOPIFY_CLIENT_SECRET for webhook HMAC
# SHOPIFY_WEBHOOK_SECRET=shpss_replace_with_your_client_secret
ADMIN_PASSWORD=adminpassword
